# Deepgram API Key (for STT and TTS)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Anthropic API Key (for Claude conversation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Calendly API Token (for booking appointments)
CALENDLY_TOKEN=your_calendly_token_here

# Port (Railway sets this automatically in production)
PORT=8080
